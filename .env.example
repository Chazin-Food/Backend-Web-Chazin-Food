DB_NAME=chazinfood
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Obligatorio en producción (mínimo 32 caracteres aleatorios: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=24h

GOOGLE_CLIENT_ID=

# Correo transaccional (Brevo API v3 recomendado en Render; SMTP como respaldo local)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Chazin Food
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Pasarela Wompi
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
